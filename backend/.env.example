# FraudLens Backend Configuration
# Copy to .env and adjust as needed.

PORT=5005

# Comma-separated list of allowed CORS origins (leave empty to allow all in dev)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# Optional: Groq LLM for AI-powered threat explanations (free tier)
# Get a free API key at https://console.groq.com/keys (no card required)
# Leave unset to use the built-in rule-based XAI instead.
# ------------------------------------------------------------------
GROQ_API_KEY=
# Optional: override the Groq model (default qwen/qwen3.8-27b; auto-falls back
# across qwen3.6-27b / llama-prompt-guard if a model is unavailable)
# GROQ_MODEL=qwen/qwen3.8-27b
